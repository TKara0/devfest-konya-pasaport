rules_version = '2';

// Tarayıcı Firestore'a hiç doğrudan erişmez.
// Tüm okuma/yazma Cloud Run API'si (Admin SDK) üzerinden yapılır;
// böylece kod listesi ve diğer kullanıcıların telefonları hiçbir zaman istemciye inmez.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
