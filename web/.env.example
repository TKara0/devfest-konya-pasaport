# Firebase konsolu → Proje ayarları → Web uygulaması yapılandırması
VITE_FIREBASE_API_KEY=
# Google girişinin Safari/iOS'ta sorunsuz çalışması için sitenin yayınlandığı alan adını yazın
# (ör. devfest-konya-pasaport.web.app ya da özel alan adınız)
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Yerelde Firebase emülatörü kullanmak için true
VITE_USE_EMULATOR=false
